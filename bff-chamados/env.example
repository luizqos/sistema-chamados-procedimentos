# --- CONFIGURAÇÕES DO SERVIDOR ---
PORT=3001

# --- BANCO DE DADOS (PRISMA) ---
# Se for rodar localmente (sem Docker), aponte para localhost. 
# O Docker sobrescreve isso com o nome do container ('postgres') em produção.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/chamados_db?schema=public"

# Conexão com o Sqlite (segunda opção para desenvolvimento)
#DATABASE_URL="file:./dev.db"

# --- SEGURANÇA E CORS ---
JWT_SECRET=sua_chave_secreta_super_segura

# Em produção, adicione os IPs separados por vírgula se usar a validação dinâmica
CORS_ORIGIN=http://localhost:3000

# --- MICROSOFT SSO (AZURE ENTRA ID) ---
MS_URL="https://login.microsoftonline.com"
MS_CLIENT_ID="seu-client-id"
MS_TENANT_ID="seu-tenant-id"