generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int            @id @default(autoincrement())
  nome          String
  email         String         @unique
  senha         String?
  ativo         Boolean        @default(true)
  ssoId         String?        @unique
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  procedimentos Procedimento[]
  created_at    DateTime       @default(now())

  @@map("usuarios")
}

model Role {
  id         Int              @id @default(autoincrement())
  nome       String           @unique
  usuarios   Usuario[]
  permissoes RolePermission[]

  @@map("roles")
}

model Permissao {
  id        Int              @id @default(autoincrement())
  chave     String           @unique
  descricao String
  roles     RolePermission[]

  @@map("permissoes")
}

model RolePermission {
  roleId      Int
  permissaoId Int
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([roleId, permissaoId])
  @@map("role_permissions")
}

model Procedimento {
  id                   Int                 @id @default(autoincrement())
  titulo               String
  descricao            String?
  script_passo_a_passo String
  usuario_id           Int?
  usuario              Usuario?            @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  anexos               ProcedimentoAnexo[]

  @@map("procedimentos")
}

model ProcedimentoAnexo {
  id              Int          @id @default(autoincrement())
  procedimento_id Int
  tipo            String
  caminho_arquivo String
  nome_original   String
  mime_type       String
  tamanho_bytes   Int
  created_at      DateTime     @default(now())
  procedimento    Procedimento @relation(fields: [procedimento_id], references: [id], onDelete: Cascade)

  @@map("procedimento_anexos")
}